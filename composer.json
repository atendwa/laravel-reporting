{
    "name": "atendwa/laravel-reporting",
    "description": "Queue-based reporting system for Laravel with Filament UI integration: generators, schedules, history, and CSV/PDF export.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "filament",
        "reporting",
        "reports",
        "pdf",
        "csv"
    ],
    "authors": [
        {
            "name": "Anthony Tendwa",
            "email": "atendwa@users.noreply.github.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "filament/filament": "^5.0",
        "illuminate/contracts": "^11.0||^12.0||^13.0",
        "laravel/prompts": "^0.3.11",
        "spatie/laravel-package-tools": "^1.16",
        "spatie/laravel-permission": "^6.20",
        "spatie/simple-excel": "^3.8"
    },
    "require-dev": {
        "barryvdh/laravel-dompdf": "^3.1",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "mpdf/mpdf": "^8.2",
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0"
    },
    "suggest": {
        "barryvdh/laravel-dompdf": "Required to use the \"dompdf\" PDF engine (config('reporting.pdf_engine')).",
        "mpdf/mpdf": "Required to use the \"mpdf\" PDF engine (config('reporting.pdf_engine'))."
    },
    "autoload": {
        "psr-4": {
            "Reporting\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Reporting\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Reporting\\Providers\\ReportingServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
